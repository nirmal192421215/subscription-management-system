# ==============================================================================
# Brightloop Software - Environment Configuration Template
# Copy this file to .env and fill in your secrets. DO NOT commit .env to Git!
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-this-to-a-very-long-random-string-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Canonical Base URL (used in emails and password reset links)
# e.g., https://your-project.vercel.app or http://localhost:8000
BASE_URL=https://brightloop.vercel.app

# Database Configuration (Leave empty to use local SQLite, or provide PostgreSQL connection string)
# e.g., postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Outbound Email Configuration (Optional - defaults to console backend if empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-password-here
DEFAULT_FROM_EMAIL=Brightloop Billing <billing@brightloop.com>

